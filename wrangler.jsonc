{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luinbytes-f1-gateway",
  "main": "workers/f1-gateway.ts",
  "compatibility_date": "2026-07-01",
  "routes": [
    {
      "pattern": "luinbytes.dev/f1*",
      "zone_name": "luinbytes.dev"
    },
    {
      "pattern": "luinbytes.dev/f1-assets/*",
      "zone_name": "luinbytes.dev"
    }
  ],
  "assets": {
    "directory": "./.f1-worker-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/f1/api/*"]
  },
  "vars": {
    "OPENF1_ORIGIN": "https://api.openf1.org"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "F1_ROOMS",
        "class_name": "F1Room"
      }
    ]
  },
  "exports": {
    "F1Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
