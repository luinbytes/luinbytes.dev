{
  "name": "luinbytes-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "tsc --noEmit && vite build && vite build --ssr app/entry-server.tsx && node scripts/prerender.mjs",
    "check": "tsc --noEmit",
    "start": "node scripts/serve-preview.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "lint": "eslint",
    "test:e2e:setup": "python3 -m pip install -r requirements-test.txt && python3 -m playwright install chromium",
    "test:e2e": "npm run build && python3 -m unittest discover -s tests/browser -p '*_test.py' -v",
    "test:pip": "node --test tests/pip-contact.test.mts",
    "test:pond": "node --test tests/pond-world.test.mts"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "0.577.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/yuka": "^0.7.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "8.3.3"
  }
}
