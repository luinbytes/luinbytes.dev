{
  "name": "luinbytes-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-sitemap.js && npm run build:f1-sw",
    "build": "next build",
    "build:f1-sw": "tsc workers/f1-sw.ts --outFile public/f1-sw.js --target ES2020 --module none --lib ES2020,WebWorker --skipLibCheck",
    "start": "next start",
    "lint": "eslint",
    "f1:gateway:dev": "wrangler dev --local",
    "f1:gateway:check": "wrangler types workers/f1-gateway-env.d.ts --check && tsc -p workers/tsconfig.json && wrangler deploy --dry-run",
    "test:f1-gateway": "node --test tests/f1-gateway.test.mts",
    "f1:gateway:deploy": "wrangler deploy",
    "test:e2e:setup": "python3 -m pip install -r requirements-test.txt && python3 -m playwright install chromium",
    "test:e2e": "python3 -m unittest discover -s tests/browser -p '*_test.py' -v"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^0.560.0",
    "next": "^16.2.10",
    "react": "19.2.1",
    "react-activity-calendar": "^3.0.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.112.0"
  }
}
